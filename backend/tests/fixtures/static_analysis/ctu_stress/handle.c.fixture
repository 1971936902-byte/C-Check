#include "handle.h"
#include <stdlib.h>

struct Handle {
    unsigned char *data;
    size_t size;
};

Handle *handle_create(size_t size)
{
    Handle *handle = malloc(sizeof(*handle));
    if (handle == NULL)
        return NULL;
    handle->data = malloc(size);
    if (handle->data == NULL) {
        free(handle);
        return NULL;
    }
    handle->size = size;
    return handle;
}

void handle_destroy(Handle *handle)
{
    if (handle == NULL)
        return;
    free(handle->data);
    free(handle);
}

int handle_touch(Handle *handle)
{
    if (handle == NULL || handle->size == 0)
        return -1;
    handle->data[0] = 1;
    return 0;
}
