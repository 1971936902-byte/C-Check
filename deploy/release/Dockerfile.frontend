ARG NODE_IMAGE
ARG NGINX_IMAGE
FROM ${NODE_IMAGE} AS builder
WORKDIR /source
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com
COPY frontend ./
RUN npm run build && test -z "$(find dist -name '*.map' -print -quit)"
FROM ${NGINX_IMAGE}
ARG RELEASE_VERSION
ARG SOURCE_SHA
LABEL org.opencontainers.image.version=${RELEASE_VERSION} org.opencontainers.image.revision=${SOURCE_SHA}
COPY --from=builder /source/dist /usr/share/nginx/html
COPY deploy/release/nginx.conf /etc/nginx/conf.d/default.conf
USER 101:101
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
