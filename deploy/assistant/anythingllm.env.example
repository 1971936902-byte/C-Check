# Server-side only. Inject the gateway key through the deployment secret loader.
LLM_PROVIDER=generic-openai
CCHECK_ASSISTANT_MODE=true
GENERIC_OPEN_AI_BASE_PATH=http://assistant-gateway:8010/v1
GENERIC_OPEN_AI_MODEL_PREF=qwen2.5-coder-32b-instruct-fp8
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=8192
GENERIC_OPEN_AI_MAX_TOKENS=1024
GENERIC_OPEN_AI_MODEL_MAX_TOKEN_KEY=max_tokens
EMBEDDING_ENGINE=generic-openai
EMBEDDING_BASE_PATH=http://assistant-gateway:8010/v1
EMBEDDING_MODEL_PREF=jina-code-embeddings-1.5b
GENERIC_OPEN_AI_EMBEDDING_MAX_CONCURRENT_CHUNKS=1
# Keep assistant documents separate from the review's Qdrant collection.
VECTOR_DB=lancedb
DISABLE_TELEMETRY=true
