[Unit]
Description=C-Check Qwen code review service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=0
Environment=HF_HOME=/opt/modelscope
Environment=VLLM_ATTENTION_BACKEND=FLASHINFER
EnvironmentFile=/etc/c-check/c-check.env
WorkingDirectory=/opt/c-check
ExecStart=/opt/vllm-cu124/bin/python -m vllm.entrypoints.openai.api_server --host 127.0.0.1 --port 8001 --model /opt/modelscope/RedHatAI/Qwen2.5-Coder-14B-Instruct-FP8-dynamic --served-model-name qwen2.5-coder-14b-instruct --api-key ${VLLM_API_KEY} --tensor-parallel-size 1 --kv-cache-dtype fp8 --calculate-kv-scales --enable-prefix-caching --gpu-memory-utilization 0.75 --max-model-len 8192 --max-num-seqs 2 --max-num-batched-tokens 8192 --speculative-config '{"method":"ngram","num_speculative_tokens":5,"prompt_lookup_max":4,"prompt_lookup_min":2}'
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
