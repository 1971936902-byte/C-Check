# C-Check native Linux deployment configuration.
# Copy this file to /etc/c-check/c-check.env or pass DEPLOY_ENV=/path/to/file.

# Git source used when APP_DIR does not already contain a checkout.
REPO_URL=https://github.com/1971936902-byte/C-Check.git
BRANCH=master
APP_DIR=/opt/c-check

# Network.
WEB_PORT=8800
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
PUBLIC_ORIGIN=http://YOUR_SERVER_IP:8800
CORS_ORIGINS=["http://YOUR_SERVER_IP:8800","http://localhost"]

# Linux service user. The installer creates it when missing.
APP_USER=c-check

# Database and Redis.
MYSQL_DATABASE=c_check
MYSQL_USER=c_check
MYSQL_PASSWORD=CHANGE_ME_USE_A_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_LOGIN="mysql -uroot"
REDIS_URL=redis://127.0.0.1:6379/0

# Application secrets.
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_ADMIN_PASSWORD

# Upload limits.
UPLOAD_MAX_FILE_BYTES=1048576
UPLOAD_MAX_ARCHIVE_BYTES=10485760
UPLOAD_MAX_EXTRACTED_BYTES=10485760
UPLOAD_MAX_FILES=200
UPLOAD_MAX_ARCHIVE_ENTRIES=1000
UPLOAD_MAX_PATH_LENGTH=512
STORAGE_PATH=/opt/c-check/uploads

# Model behavior.
MOCK_MODEL_ENABLED=false
MODEL_MAX_ATTEMPTS=3
MODEL_MAX_TOKENS=2048
CANDIDATE_MODEL_MAX_TOKENS=2048
MODEL_STRUCTURED_OUTPUTS_ENABLED=true
CANDIDATE_FORMAT_MODEL_ENABLED=true
CANDIDATE_FORMAT_BATCH_SIZE=10
# RAG embedding. Keep hashing for minimal installs; use the profile below when
# an OpenAI-compatible embedding service is available.
RAG_EMBEDDING_BACKEND=hashing
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=hashing-code-embedding-v1
RAG_EMBEDDING_DIMENSION=128
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_MAX_CHARS=16000
RAG_EMBEDDING_ALLOW_HASH_FALLBACK=true
RAG_EMBEDDING_QUERY_PREFIX=
RAG_EMBEDDING_PASSAGE_PREFIX=
RAG_QDRANT_COLLECTION=c_check_code_chunks
CANDIDATE_SEMANTIC_FALLBACK_ENABLED=true
CANDIDATE_SEMANTIC_BATCH_SIZE=12
CANDIDATE_SEMANTIC_MAX_TOKENS=384
# Jina Code Embeddings 1.5B profile:
# RAG_EMBEDDING_BACKEND=openai-compatible
# RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8002
# RAG_EMBEDDING_MODEL=jina-code-embeddings-1.5b
# RAG_EMBEDDING_DIMENSION=1536
# RAG_EMBEDDING_BATCH_SIZE=8
# RAG_EMBEDDING_MAX_CHARS=16000
# RAG_EMBEDDING_ALLOW_HASH_FALLBACK=false
# RAG_EMBEDDING_QUERY_PREFIX=Find the most relevant code snippet given the following query:\n
# RAG_EMBEDDING_PASSAGE_PREFIX=Candidate code snippet:\n
# RAG_QDRANT_COLLECTION=c_check_code_jina_1_5b_1536
MODEL_CATALOG_PATH=/opt/c-check/deploy/models/catalog.json
MODEL_DEPLOYMENT_ENABLED=false
MODEL_DEPLOYMENT_SCRIPT=/opt/c-check/deploy/models/deploy-vllm-model.sh
ALLOW_INSECURE_DEFAULTS=false

# Native runtime versions.
PYTHON_BIN=python3
PYTHON_VERSION=3.12
NODE_MAJOR=22
NODE_VERSION=22.21.1
NODE_DIST_URL=https://npmmirror.com/mirrors/node
NODE_INSTALL_DIR=/opt/nodejs/22.21.1

# Optional: register a real local VLLM node after install.
# Leave REGISTER_VLLM_MODEL=false when model service is deployed separately.
REGISTER_VLLM_MODEL=false
VLLM_DISPLAY_NAME=Qwen2.5 Coder 32B AWQ
VLLM_MODEL_IDENTIFIER=qwen2.5-coder-32b-awq
VLLM_BASE_URL=http://127.0.0.1:8001
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=600
